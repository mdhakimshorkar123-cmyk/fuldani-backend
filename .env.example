NODE_ENV=development
PORT=4000

# ── Neon Postgres ───────────────────────────────────────────
# Pooled connection (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no "-pooler") — used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── Redis (optional — app falls back to no-cache if unset/unreachable) ──
# Local: redis://localhost:6379   Upstash: rediss://default:TOKEN@xxx.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# ── Auth ────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_TTL_SECONDS=604800

# Comma-separated list of allowed browser origins
CORS_ORIGINS="http://localhost:3000"

# ── Seed (first admin account) ─────────────────────────────
SEED_ADMIN_EMAIL="admin@shopnofuldani.com"
SEED_ADMIN_PASSWORD="ChangeMe@123"
SEED_ADMIN_NAME="Super Admin"
